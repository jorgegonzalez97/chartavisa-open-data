      "contentUrl": "us-visa-wait-times/index.json",
      "encodingFormat": "application/json",
      "sha256": "c400531709a60cf43b1289cffafbe89a2082be8b106d344aa4314402b35c4df5"
    },
    {
      "@type": "cr:FileObject",
      "@id": "visa-requirements-csv",
      "name": "visa-requirements.csv",
      "description": "One row per (nationality, destination) pair: product, government fee + currency, service availability, processing, validity, official government source.",
      "contentUrl": "visa-requirements.csv",
      "encodingFormat": "text/csv",
      "sha256": "e0962a5d6cfb1841e061e63bbd440cf46f77b38b3a79a3127b4423fa47435ef7"
    },
    {
      "@type": "cr:FileObject",
      "@id": "visa-requirements-json",
