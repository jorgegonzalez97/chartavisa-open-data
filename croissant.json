  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "Charta Visa Travel Authorization Data",
  "description": "Open data on travel authorizations (ESTA, UK ETA, ETIAS, Canada eTA, US B1/B2 visa): which nationality needs which product, the government fee in its own currency, validity, processing, the official government source for every row, the 2026 'Cost of Crossing Borders' report tables, and a monthly time series of U.S. visitor-visa interview wait times as published by the U.S. Department of State. Charta Visa is an independent private service, not a government website. Government fees are stated separately and paid to the authorities in full.",
  "url": "https://chartavisa.com/research",
  "sameAs": [
    "https://github.com/jorgegonzalez97/chartavisa-open-data",
    "https://huggingface.co/datasets/chartavisa/travel-authorization-data"
  ],
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "isAccessibleForFree": true,
  "isLiveDataset": true,
  "creator": {
    "@type": "sc:Organization",
    "name": "Charta Visa",
    "url": "https://chartavisa.com"
  },
  "datePublished": "2026-06-01",
  "version": "2026-07-28",
  "identifier": "https://doi.org/10.5281/zenodo.22851176",
  "citeAs": "Charta Visa. Charta Visa Travel Authorization Data. https://doi.org/10.5281/zenodo.22851176",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "entry-cost-2026-csv",
      "name": "entry-cost-2026.csv",
      "description": "Tables behind 'The Cost of Crossing Borders 2026': per-authorization fees, validity, fee history and eligible-nationality counts, then per-nationality authorization burden and total government fees (USD).",
      "contentUrl": "entry-cost-2026.csv",
      "encodingFormat": "text/csv",
      "sha256": "8ff9d62ff06ff03f2e828599f48b6f4aa17c6548d26a6008eab5d3af846a2967"
    },
    {
      "@type": "cr:FileObject",
      "@id": "us-visa-wait-times-2026-07-28-json",
      "name": "us-visa-wait-times/2026-07-28.json",
      "description": "U.S. visitor-visa wait times by consular post, State Department vintage 2026-07-28.",
      "contentUrl": "us-visa-wait-times/2026-07-28.json",
      "encodingFormat": "application/json",
      "sha256": "e51f9f6f8d16dc047a0a85f1987219d8462cdbeac5840f62b7e7d1a46491a36d"
    },
    {
      "@type": "cr:FileObject",
      "@id": "us-visa-wait-times-index-json",
